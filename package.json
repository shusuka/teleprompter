{
  "name": "sorot",
  "version": "1.0.3",
  "description": "Prompter paparan untuk narasumber: naskah menyala mengikuti suara di atas slide, dekat kamera.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64 --publish never",
    "dist:local": "vite build && electron-builder --win --x64 --publish never -c.electronDist=node_modules/electron/dist"
  },
  "author": "shusuka",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "productName": "Sorot",
  "private": true,
  "build": {
    "appId": "id.shusuka.sorot",
    "productName": "Sorot",
    "copyright": "shusuka",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Sorot",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shusuka",
        "repo": "teleprompter"
      }
    ]
  }
}
